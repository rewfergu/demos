---
import { getCollection } from "astro:content";
---

<html>
  <head>
    <title>Demos</title>
  </head>
  <body>
    <h1>Demos</h1>
    <ul>
      {
        (await getCollection("demos")).map((demo) => (
          <li>
            <a href={`/${demo.slug}`}>{demo.data.name}</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>

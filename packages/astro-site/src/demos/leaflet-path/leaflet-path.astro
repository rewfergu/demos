<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<script
  defer
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>

<script defer src="https://unpkg.com/leaflet.path.drag@0.0.6/src/Path.Drag.js"
></script>

<div id="map"></div>

<script is:inline>
  const tile =
    "data:image/png;base64,";
  document
    .querySelector('script[src*="leaflet"]')
    .addEventListener("load", function () {
      var map = L.map("map").setView([44.967243, -103.771556], 8);
      // map.dragging.disable();
      L.tileLayer(tile, {
        maxZoom: 19,
      }).addTo(map);

      // Create a new polyline for user clicks
      var userPolyline = L.polyline([], {
        color: "#3aa0c0",
        dashArray: "1 2",
        weight: 1,
      }).addTo(map);

      // Array to store point markers
      var pointMarkers = [];

      // Function to create a draggable point
      function createDraggablePoint(latlng) {
        var point = L.circleMarker(latlng, {
          radius: 8,
          fillColor: "#3aa0c0",
          color: "#3aa0c0",
          weight: 1,
          opacity: 0.8,
          fillOpacity: 0.8,
          draggable: true,
          clickable: true,
        }).addTo(map);

        // Prevent map dragging when interacting with points
        point.on("mousedown touchstart", function (e) {
          e.originalEvent.stopPropagation();
          e.originalEvent.preventDefault();
          map.dragging.disable();
        });

        point.on("mouseup touchend", function () {
          map.dragging.enable();
        });

        // Prevent adding new points when clicking on existing markers
        point.on("click", function (e) {
          L.DomEvent.stopPropagation(e);
          console.log("click on a point");
        });

        // Update polyline when point is dragged
        point.on("dragend", function (e) {
          var index = pointMarkers.indexOf(point);
          if (index !== -1) {
            var latlngs = userPolyline.getLatLngs();
            latlngs[index] = e.target.getLatLng();
            userPolyline.setLatLngs(latlngs);
          }
        });

        return point;
      }

      // Add click handler to add points
      map.on("click", function (e) {
        userPolyline.addLatLng(e.latlng);
        var newPoint = createDraggablePoint(e.latlng);
        pointMarkers.push(newPoint);
        console.log("click on a map");
      });
    });
</script>

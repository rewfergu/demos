<script defer src="https://unpkg.com/maplibre-gl@latest/dist/maplibre-gl.js"
></script>

<link
  href="https://unpkg.com/maplibre-gl@latest/dist/maplibre-gl.css"
  rel="stylesheet"
/>

<div id="map" style="width: 100%; height: 600px;"></div>

<script is:inline>
  const tile =
    'data:image/png;base64,';

  document
    .querySelector('script[src*="maplibre-gl"]')
    .addEventListener('load', function () {
      var coordinates = [];
      var markers = [];
      var isDragging = false;
      var dragIndex = -1;

      var map = new maplibregl.Map({
        container: 'map',
        style: {
          version: 8,
          sources: {
            'svg-background': {
              type: 'raster',
              tiles: [tile],
              tileSize: 256,
            },
          },
          layers: [
            {
              id: 'static-map',
              type: 'raster',
              source: 'svg-background',
              minzoom: 0,
              maxzoom: 19,
            },
          ],
        },
        center: [-103.771556, 44.967243],
        zoom: 8,
      });

      map.on('load', function () {
        // Add the polyline source and layer
        map.addSource('path', {
          type: 'geojson',
          data: {
            type: 'Feature',
            geometry: {
              type: 'LineString',
              coordinates: [],
            },
          },
        });

        map.addLayer({
          id: 'path-line',
          type: 'line',
          source: 'path',
          paint: {
            'line-color': '#3aa0c0',
            'line-width': 1,
            'line-dasharray': [1, 2],
          },
        });

        // Add the points source and layer
        map.addSource('points', {
          type: 'geojson',
          data: {
            type: 'FeatureCollection',
            features: [],
          },
        });

        map.addLayer({
          id: 'points-layer',
          type: 'circle',
          source: 'points',
          paint: {
            'circle-radius': 8,
            'circle-color': '#3aa0c0',
            'circle-opacity': 0.8,
            'circle-stroke-color': '#3aa0c0',
            'circle-stroke-width': 1,
            'circle-stroke-opacity': 0.8,
          },
        });

        function updatePath() {
          map.getSource('path').setData({
            type: 'Feature',
            geometry: {
              type: 'LineString',
              coordinates: coordinates,
            },
          });
        }

        function updatePoints() {
          map.getSource('points').setData({
            type: 'FeatureCollection',
            features: coordinates.map(function (coord, i) {
              return {
                type: 'Feature',
                geometry: {
                  type: 'Point',
                  coordinates: coord,
                },
                properties: {
                  index: i,
                },
              };
            }),
          });
        }

        // Add a point on map click
        map.on('click', function (e) {
          if (isDragging) return;

          // Check if click is on an existing point
          var features = map.queryRenderedFeatures(e.point, {
            layers: ['points-layer'],
          });
          if (features.length > 0) {
            console.log('click on a point');
            return;
          }

          var coord = [e.lngLat.lng, e.lngLat.lat];
          coordinates.push(coord);
          updatePath();
          updatePoints();
          console.log('click on a map');
        });

        // Change cursor on point hover
        map.on('mouseenter', 'points-layer', function () {
          map.getCanvas().style.cursor = 'grab';
        });

        map.on('mouseleave', 'points-layer', function () {
          if (!isDragging) {
            map.getCanvas().style.cursor = '';
          }
        });

        // Dragging points
        map.on('mousedown', 'points-layer', function (e) {
          e.preventDefault();
          isDragging = true;
          dragIndex = e.features[0].properties.index;
          map.getCanvas().style.cursor = 'grabbing';
          map.dragPan.disable();
        });

        map.on('mousemove', function (e) {
          if (!isDragging || dragIndex === -1) return;
          coordinates[dragIndex] = [e.lngLat.lng, e.lngLat.lat];
          updatePath();
          updatePoints();
        });

        map.on('mouseup', function () {
          if (!isDragging) return;
          isDragging = false;
          dragIndex = -1;
          map.getCanvas().style.cursor = '';
          map.dragPan.enable();
        });

        // Touch support for dragging
        map.on('touchstart', 'points-layer', function (e) {
          e.preventDefault();
          isDragging = true;
          dragIndex = e.features[0].properties.index;
          map.dragPan.disable();
        });

        map.on('touchmove', function (e) {
          if (!isDragging || dragIndex === -1) return;
          var coords = e.lngLat;
          coordinates[dragIndex] = [coords.lng, coords.lat];
          updatePath();
          updatePoints();
        });

        map.on('touchend', function () {
          if (!isDragging) return;
          isDragging = false;
          dragIndex = -1;
          map.dragPan.enable();
        });
      });
    });
</script>
